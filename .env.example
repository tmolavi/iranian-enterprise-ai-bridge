# ==============================================================================
# Iranian Enterprise AI Bridge (IEAB) — Environment Configuration
# ==============================================================================

# Application & Server
NODE_ENV=production
PORT=3000
WEB_PORT=3001
LOG_LEVEL=info

# Database & Cache
DATABASE_URL=postgres://ieab_user:ieab_secure_password_2026@localhost:5432/ieab_canonical
REDIS_URL=redis://localhost:6379

# AI Gateway Configuration (Cloud / Local vLLM / Ollama)
AI_PROVIDER=LOCAL_VLLM
AI_MODEL=Qwen/Qwen2.5-72B-Instruct-GPTQ
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=local-key
AI_ONLINE=false

# Cloud AI Fallback (Optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Enterprise Security & Kill-Switch
SECURITY_ENFORCE_READONLY=true
SECURITY_MASK_PII=true
KILL_SWITCH_ENABLED=false
